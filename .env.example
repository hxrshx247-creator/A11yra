# Copy to .env. Local SQLite and console mail work with these defaults.
A11YRA_ENV=dev
A11YRA_PUBLIC_URL=http://127.0.0.1:5173
A11YRA_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# A11YRA_SECRET=
# DATABASE_URL=postgresql+psycopg://user:password@host/a11yra
# A11YRA_DATA_DIR=
A11YRA_FILE_HOURS=24
A11YRA_AUDIT_DAYS=30
# A11YRA_IP_REQUESTS_PER_MINUTE=180

# Required outside development. SMTP uses STARTTLS.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_FROM=
# SMTP_USER=
# SMTP_PASSWORD=

STRIPE_TEST_ENABLED=0
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_EDUCATOR=
# STRIPE_PRICE_INSTITUTION=
# A11YRA_DEMO_PLAN_CHANGES=0

# A11YRA_METRICS_TOKEN=
# A11YRA_SENTRY_DSN=
# Public contact used by the frontend build. Rebuild after changing it.
# SUPPORT_EMAIL=
